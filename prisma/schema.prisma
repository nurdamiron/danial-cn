generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  brand         String
  nameRu        String
  nameKk        String
  descriptionRu String           @default("")
  descriptionKk String           @default("")
  materialRu    String           @default("")
  materialKk    String           @default("")
  category      String           @default("cabin")
  basePriceKzt  Int
  heightCm      Float?
  widthCm       Float?
  depthCm       Float?
  volumeL       Float?
  weightKg      Float?
  wheels        String?
  lockType      String?
  isReplica     Boolean          @default(true)
  status        String           @default("draft")
  featured      Boolean          @default(false)
  sortOrder     Int              @default(0)
  variants      ProductVariant[]
  images        ProductImage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductVariant {
  id           String         @id @default(cuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String         @unique
  colorKey     String
  colorLabelRu String
  colorLabelKk String
  colorHex     String         @default("#888888")
  sizeKey      String
  sizeLabelRu  String
  sizeLabelKk  String
  priceKzt     Int?
  stock        Int            @default(0)
  images       ProductImage[]
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Links gallery photo to a color swatch (e.g. black, silver)
  colorKey  String?
  url       String
  sortOrder Int             @default(0)
  isCover   Boolean         @default(false)
  width     Int?
  height    Int?
  createdAt DateTime        @default(now())
}

model SiteSettings {
  id                Int    @id @default(1)
  whatsappE164      String @default("77001234567")
  deliveryCargoRu   String @default("Карго — экономичная доставка по Казахстану")
  deliveryCargoKk   String @default("Карго — Қазақстан бойынша үнемді жеткізу")
  deliveryAviaRu    String @default("Авиа — быстрее карго")
  deliveryAviaKk    String @default("Әуе — каргодан жылдамырақ")
  deliveryExpressRu String @default("Экспресс — самый быстрый вариант")
  deliveryExpressKk String @default("Экспресс — ең жылдам нұсқа")
  kaspiNoteRu       String @default("Оплата после подтверждения заказа")
  kaspiNoteKk       String @default("Тапсырыс расталғаннан кейін төлем")
  disclaimerRu      String @default("Все товары это копии 1 в 1 (реплики), не оригинальные бренды.")
  disclaimerKk      String @default("Барлық тауарлар 1 ге 1 көшірмелер (реплика), түпнұсқа бренд емес.")
}

/// role: USER (default) | ADMIN (exactly one in the system)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String   @default("")
  role         String   @default("USER")
  /// Set to refuse sign-in without deleting the account and its history.
  blockedAt    DateTime?
  /// Bumped to invalidate every session already issued to this user. The
  /// number is signed into the cookie, so a password change or a "sign out
  /// everywhere" takes effect immediately instead of waiting out the 14 days.
  sessionVersion Int    @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One row per sign-in attempt. Read for rate limiting on the way in, and by
/// the admin security log to show who has been knocking.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// login or register.
  action    String   @default("login")
  email     String
  ip        String   @default("")
  success   Boolean  @default(false)
  /// Why it failed: no_user, bad_password, blocked, rate_limited.
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}
