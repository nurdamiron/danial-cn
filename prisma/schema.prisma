generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  /// House line key, e.g. ALUMA. The two labels below are what the storefront
  /// prints; the key is what filters match on.
  brand         String
  brandRu       String           @default("")
  brandKk       String           @default("")
  taglineRu     String           @default("")
  taglineKk     String           @default("")
  nameRu        String
  nameKk        String
  descriptionRu String           @default("")
  descriptionKk String           @default("")
  materialRu    String           @default("")
  materialKk    String           @default("")
  category      String           @default("cabin")
  basePriceKzt  Int
  heightCm      Float?
  widthCm       Float?
  depthCm       Float?
  volumeL       Float?
  weightKg      Float?
  wheels        String?
  lockType      String?
  isReplica     Boolean          @default(true)
  status        String           @default("draft")
  featured      Boolean          @default(false)
  sortOrder     Int              @default(0)
  variants      ProductVariant[]
  images        ProductImage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductVariant {
  id           String         @id @default(cuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String         @unique
  colorKey     String
  colorLabelRu String
  colorLabelKk String
  colorHex     String         @default("#888888")
  sizeKey      String
  sizeLabelRu  String
  sizeLabelKk  String
  priceKzt     Int?
  stock        Int            @default(0)
  images       ProductImage[]
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Links gallery photo to a color swatch (e.g. black, silver)
  colorKey  String?
  url       String
  sortOrder Int             @default(0)
  isCover   Boolean         @default(false)
  width     Int?
  height    Int?
  createdAt DateTime        @default(now())
}

model SiteSettings {
  id                Int    @id @default(1)
  whatsappE164      String @default("77001234567")
  deliveryCargoRu   String @default("Карго — экономичная доставка по Казахстану")
  deliveryCargoKk   String @default("Карго — Қазақстан бойынша үнемді жеткізу")
  deliveryAviaRu    String @default("Авиа — быстрее карго")
  deliveryAviaKk    String @default("Әуе — каргодан жылдамырақ")
  deliveryExpressRu String @default("Экспресс — самый быстрый вариант")
  deliveryExpressKk String @default("Экспресс — ең жылдам нұсқа")
  kaspiNoteRu       String @default("Оплата после подтверждения заказа")
  kaspiNoteKk       String @default("Тапсырыс расталғаннан кейін төлем")
  disclaimerRu      String @default("Все товары это копии 1 в 1 (реплики), не оригинальные бренды.")
  disclaimerKk      String @default("Барлық тауарлар 1 ге 1 көшірмелер (реплика), түпнұсқа бренд емес.")
}

/// role: USER (default) | ADMIN (exactly one in the system)
model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  phone          String          @default("")
  role           String          @default("USER")
  /// Set to refuse sign-in without deleting the account and its history.
  blockedAt      DateTime?
  /// Bumped to invalidate every session already issued to this user. The
  /// number is signed into the cookie, so a password change or a "sign out
  /// everywhere" takes effect immediately instead of waiting out the 14 days.
  sessionVersion Int             @default(0)
  lastLoginAt    DateTime?
  orders         Order[]
  resets         PasswordReset[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

/// An order as the shop recorded it, written before the customer is handed to
/// WhatsApp. Until now the only trace of a sale was the chat itself and a copy
/// in the buyer's own browser, so clearing site data erased the history for
/// both sides.
model Order {
  id            String      @id @default(cuid())
  /// Short human-readable code, repeated in the WhatsApp message so a chat can
  /// be matched to this row.
  number        String      @unique
  /// Set when the buyer was signed in. Orders from guests are kept too.
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String      @default("")
  city          String
  /// cargo, avia or express.
  delivery      String
  comment       String      @default("")
  /// Recomputed from the catalogue on the server, never taken from the client.
  totalKzt      Int
  /// new, confirmed, shipped, done or cancelled.
  status        String      @default("new")
  /// cart or quick.
  source        String      @default("cart")
  ip            String      @default("")
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  slug         String
  brand        String
  name         String
  colorLabel   String @default("")
  sizeLabel    String @default("")
  /// Copied at the time of sale. The catalogue price can change later; what
  /// was agreed should not.
  unitPriceKzt Int
  qty          Int
  imageUrl     String @default("")

  @@index([orderId])
}

/// A pending password reset. The link carries a random token; only its hash is
/// stored, so a leak of this table cannot be used to take an account over.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  /// Set when an admin generated the link by hand, to send over WhatsApp.
  issuedBy  String    @default("self")
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One row per sign-in attempt. Read for rate limiting on the way in, and by
/// the admin security log to show who has been knocking.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// login or register.
  action    String   @default("login")
  email     String
  ip        String   @default("")
  success   Boolean  @default(false)
  /// Why it failed: no_user, bad_password, blocked, rate_limited.
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// What happened on the storefront, including to the people who did not buy.
///
/// The sale itself finishes in WhatsApp, off this site, so the Order table
/// only ever records the visits that succeeded. Without this one the shop can
/// see that it sold seven bags and nothing at all about the two hundred
/// visits that ended somewhere along the way — which is where the money is
/// actually lost.
///
/// Nothing here identifies a person: no account, no address, no IP. `visitId`
/// is a random string the browser keeps for one visit and then forgets, which
/// is enough to follow a single path through the shop and nothing more.
model Event {
  id      String  @id @default(cuid())
  /// store_view, product_view, cart_add, checkout_open or whatsapp_click.
  type    String
  visitId String
  locale  String  @default("ru")
  /// The product this was about, for the events that concern one.
  slug    String?
  /// Host the visit arrived from, first touch only — never a full URL, which
  /// is where search queries and personal parameters tend to hide.
  source  String  @default("")
  /// Phone, tablet or desktop, from the viewport at the time.
  device  String  @default("")

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([slug, type, createdAt])
  @@index([visitId, createdAt])
  @@index([createdAt])
}
