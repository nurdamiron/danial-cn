generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id            String           @id @default(cuid())
  slug          String           @unique
  brand         String
  nameRu        String
  nameKk        String
  descriptionRu String           @default("")
  descriptionKk String           @default("")
  materialRu    String           @default("")
  materialKk    String           @default("")
  category      String           @default("cabin")
  basePriceKzt  Int
  heightCm      Float?
  widthCm       Float?
  depthCm       Float?
  volumeL       Float?
  weightKg      Float?
  wheels        String?
  lockType      String?
  isReplica     Boolean          @default(true)
  status        String           @default("draft")
  featured      Boolean          @default(false)
  sortOrder     Int              @default(0)
  variants      ProductVariant[]
  images        ProductImage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductVariant {
  id           String         @id @default(cuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String         @unique
  colorKey     String
  colorLabelRu String
  colorLabelKk String
  sizeKey      String
  sizeLabelRu  String
  sizeLabelKk  String
  priceKzt     Int?
  stock        Int            @default(0)
  images       ProductImage[]
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  sortOrder Int             @default(0)
  isCover   Boolean         @default(false)
  width     Int?
  height    Int?
  createdAt DateTime        @default(now())
}

model SiteSettings {
  id                Int    @id @default(1)
  whatsappE164      String @default("77001234567")
  deliveryCargoRu   String @default("Карго — экономичная доставка по Казахстану")
  deliveryCargoKk   String @default("Карго — Қазақстан бойынша үнемді жеткізу")
  deliveryAviaRu    String @default("Авиа — быстрее карго")
  deliveryAviaKk    String @default("Әуе — каргодан жылдамырақ")
  deliveryExpressRu String @default("Экспресс — самый быстрый вариант")
  deliveryExpressKk String @default("Экспресс — ең жылдам нұсқа")
  kaspiNoteRu       String @default("Оплата через Kaspi после подтверждения заказа в WhatsApp")
  kaspiNoteKk       String @default("Тапсырыс WhatsApp-та расталғаннан кейін Kaspi арқылы төлем")
  disclaimerRu      String @default("Все товары — копии 1:1 (реплики), не оригинальные бренды.")
  disclaimerKk      String @default("Барлық тауарлар — 1:1 көшірмелер (реплика), түпнұсқа бренд емес.")
}
