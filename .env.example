# ── Database ─────────────────────────────────────────────────────────────
# Local development: a SQLite file.
DATABASE_URL="file:./prisma/dev.db"

# Production (Vercel): Turso. Same SQLite dialect, so the schema, the seed and
# every query are identical — only the connection changes.
#   npm i -g @tursodatabase/turso-cli   (or: brew install tursodatabase/tap/turso)
#   turso auth signup
#   turso db create danial-cn
#   turso db show danial-cn --url          → TURSO_DATABASE_URL
#   turso db tokens create danial-cn       → TURSO_AUTH_TOKEN
# Set both in Vercel → Settings → Environment Variables, then seed once:
#   TURSO_DATABASE_URL=... TURSO_AUTH_TOKEN=... npm run db:push:turso && npm run db:seed
# TURSO_DATABASE_URL="libsql://danial-cn-you.turso.io"
# TURSO_AUTH_TOKEN="ey..."

# ── Auth ─────────────────────────────────────────────────────────────────
# Signs session cookies. MUST be a long random string in production —
# generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Seed account. Change the password before exposing the site.
ADMIN_EMAIL="admin@danial.cn"
ADMIN_PASSWORD="danial-admin"
ADMIN_NAME="Admin"

# ── Store ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_E164="77066316449"
NEXT_PUBLIC_INSTAGRAM="danial_cn"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Catalog source ───────────────────────────────────────────────────────
# The storefront reads products from src/data/static-products.json so catalog
# pages stay static. Accounts always use the database above.
# Force the static catalog locally to preview exactly what production serves:
# USE_STATIC_CATALOG="1"

# ── Admin host split (optional) ──────────────────────────────────────────
# By default /admin is served from the same origin as the store, which is what
# a single Vercel project needs.
#
# Set NEXT_PUBLIC_ADMIN_URL only if the admin app really lives on its own host —
# /admin* and /api/admin* are then redirected there in production. Vercel cannot
# serve admin.danial-cn.vercel.app, so use a second project
# (admin-danial-cn → https://admin-danial-cn.vercel.app) or admin.yourdomain.kz.
# NEXT_PUBLIC_ADMIN_URL="https://admin-danial-cn.vercel.app"
ADMIN_HOSTS="admin-danial-cn.vercel.app,admin.localhost,admin.localhost:3000"
# Force the redirect even when the origins look the same
# ADMIN_HOST_SPLIT="1"
